{
  "name": "marketplace-ts-api",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "start": "tsc && npm run dev",
    "prebuild": "tslint -c tslint.json -p tsconfig.json --fix",
    "build": "tsc",
    "dev": "ts-node server.ts",
    "prestart": "npm run build",
    "ts.check": "tsc --project tsconfig.json",
    "add-build": "git add dist",
    "migrate:make": "knex --knexfile src/knexfile.ts -x ts migrate:make",
    "migrate:latest": "knex --knexfile src/knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile src/knexfile.ts migrate:rollback"
  },
  "pre-commit": [
    "ts.check",
    "build",
    "add-build"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/helmet": "^4.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.8",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.14",
    "nodemon": "^3.1.9",
    "pre-commit": "^1.0.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tslint": "^6.1.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "8.0.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.5",
    "kysely-data-api": "^1.0.1",
    "kysely-neon": "^1.3.0",
    "lru-cache": "^11.0.2",
    "mongoose": "^8.11.0",
    "morgan": "^1.10.0",
    "node": "^23.9.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.3",
    "postgres": "^3.4.5",
    "shelljs": "^0.8.5",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  }
}
